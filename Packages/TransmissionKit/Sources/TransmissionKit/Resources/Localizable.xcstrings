{
  "sourceLanguage" : "en",
  "strings" : {
    "The server address is invalid: %@" : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няправільны адрас сервера: %@"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adreça del servidor no és vàlida: %@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa serveru je neplatná: %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveradressen er ugyldig: %@"
