    "The server tried to redirect the connection to a different address. The request was blocked to protect your credentials." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер паспрабаваў перанакіраваць падлучэнне на іншы адрас. Запыт заблакіраваны для абароны вашых уліковых даных."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha intentat redirigir la connexió a una adreça diferent. S'ha bloquejat la sol·licitud per protegir les teves credencials."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server se pokusil přesměrovat připojení na jinou adresu. Požadavek byl zablokován, aby byly chráněny vaše přihlašovací údaje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren forsøgte at omdirigere forbindelsen til en anden adresse. Anmodningen blev blokeret for at beskytte dine loginoplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
