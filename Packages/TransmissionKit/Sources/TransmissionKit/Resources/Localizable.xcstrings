          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής προσπάθησε να ανακατευθύνει τη σύνδεση σε άλλη διεύθυνση. Το αίτημα αποκλείστηκε για την προστασία των διαπιστευτηρίων σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
