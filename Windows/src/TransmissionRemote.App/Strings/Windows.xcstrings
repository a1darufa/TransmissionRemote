        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível encontrar o nome do servidor. Verifique o endereço." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Numele serverului nu a fost găsit. Verificați adresa." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось найти имя сервера. Проверьте адрес." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Serverns namn hittades inte. Kontrollera adressen." } },
