      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Злучэнне з серверам страчана." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "S’ha perdut la connexió amb el servidor." } },
