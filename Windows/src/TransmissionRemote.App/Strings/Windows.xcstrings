    },
    "The server didn't answer in time." : {
      "comment" : "Windows only. Shown when the server can't be reached (the Mac shows macOS's own text for these).",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Сервер не адказаў своечасова." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "El servidor no ha respost a temps." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Server neodpověděl včas." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Serveren svarede ikke i tide." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Server hat nicht rechtzeitig geantwortet." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο διακομιστής δεν απάντησε εγκαίρως." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El servidor no respondió a tiempo." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Palvelin ei vastannut ajoissa." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le serveur n’a pas répondu à temps." } },
        "hr" : { "stringUnit" : { "state" : "translated", "value" : "Poslužitelj nije odgovorio na vrijeme." } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "A szerver nem válaszolt időben." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il server non ha risposto in tempo." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "서버가 제시간에 응답하지 않았습니다." } },
        "lt" : { "stringUnit" : { "state" : "translated", "value" : "Serveris neatsakė laiku." } },
        "lv" : { "stringUnit" : { "state" : "translated", "value" : "Serveris neatbildēja laikā." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Tjeneren svarte ikke i tide." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De server antwoordde niet op tijd." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Serwer nie odpowiedział na czas." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O servidor não respondeu a tempo." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "O servidor não respondeu a tempo." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Serverul nu a răspuns la timp." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сервер не ответил вовремя." } },
