    "The proxy rejected the username or password." : {
      "comment" : "Windows only. The proxy server in the server's settings refused its login.",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Проксі-сервер адхіліў імя карыстальніка або пароль." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "El servidor proxy ha rebutjat el nom d'usuari o la contrasenya." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Proxy server odmítl uživatelské jméno nebo heslo." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Proxyserveren afviste brugernavnet eller adgangskoden." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Proxyserver hat den Benutzernamen oder das Passwort abgelehnt." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο διακομιστής proxy απέρριψε το όνομα χρήστη ή το συνθηματικό." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El servidor proxy ha rechazado el nombre de usuario o la contraseña." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Välityspalvelin hylkäsi käyttäjätunnuksen tai salasanan." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le serveur proxy a rejeté le nom d’utilisateur ou le mot de passe." } },
        "hr" : { "stringUnit" : { "state" : "translated", "value" : "Proxy poslužitelj je odbio korisničko ime ili lozinku." } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "A proxyszerver elutasította a felhasználónevet vagy a jelszót." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il server proxy ha rifiutato il nome utente o la password." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프록시 서버가 사용자 이름 또는 암호를 거부했습니다." } },
        "lt" : { "stringUnit" : { "state" : "translated", "value" : "Tarpinis serveris atmetė vartotojo vardą arba slaptažodį." } },
        "lv" : { "stringUnit" : { "state" : "translated", "value" : "Proksi serveris noraidīja lietotājvārdu vai paroli." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Proxytjeneren avviste brukernavnet eller passordet." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De proxyserver heeft de gebruikersnaam of het wachtwoord geweigerd." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Serwer proxy odrzucił nazwę użytkownika lub hasło." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O servidor proxy rejeitou o nome de usuário ou a senha." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "O servidor proxy rejeitou o nome de utilizador ou a palavra-passe." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Serverul proxy a respins numele de utilizator sau parola." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Прокси-сервер отклонил имя пользователя или пароль." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Proxyservern avvisade användarnamnet eller lösenordet." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Proxy sunucusu kullanıcı adını veya parolayı reddetti." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Проксі-сервер відхилив ім’я користувача або пароль." } },
