    "Connection to this PC." : {
      "comment" : "Windows only. Status bar tooltip for a server on this computer (localhost); the Mac says \"Connection to this Mac.\" Use the word Windows uses for the computer in your language.",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Падлучэнне да гэтага камп’ютара." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Connexió a aquest PC." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Připojení k tomuto počítači." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Forbindelse til denne pc." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbindung zu diesem PC." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Σύνδεση σε αυτόν τον υπολογιστή." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Conexión con este equipo." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Yhteys tähän tietokoneeseen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connexion à ce PC." } },
        "hr" : { "stringUnit" : { "state" : "translated", "value" : "Veza s ovim računalom." } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "Kapcsolat ezzel a számítógéppel." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Connessione a questo PC." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 PC에 대한 연결입니다." } },
        "lt" : { "stringUnit" : { "state" : "translated", "value" : "Ryšys su šiuo kompiuteriu." } },
        "lv" : { "stringUnit" : { "state" : "translated", "value" : "Savienojums ar šo datoru." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Tilkobling til denne PC-en." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Verbinding met deze pc." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Połączenie z tym komputerem." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conexão com este computador." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Ligação a este PC." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Conexiune către acest PC." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключение к этому компьютеру." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslutning till den här datorn." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu bilgisayara bağlantı." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Підключення до цього комп’ютера." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "与这台电脑的连接。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "與這台電腦的連線。" } }
      }
    },
    "Couldn't connect through the proxy server. Check its address and port." : {
      "comment" : "Windows only. Shown when the server can't be reached (the Mac shows macOS's own text for these).",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Не ўдалося падключыцца праз проксі-сервер. Праверце яго адрас і порт." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "No s’ha pogut connectar a través del servidor proxy. Comproveu-ne l’adreça i el port." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Přes proxy server se nepodařilo připojit. Zkontrolujte jeho adresu a port." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Kunne ikke oprette forbindelse via proxyserveren. Kontrollér dens adresse og port." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Verbindung über den Proxyserver möglich. Prüfe seine Adresse und seinen Port." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Δεν ήταν δυνατή η σύνδεση μέσω του διακομιστή proxy. Ελέγξτε τη διεύθυνση και τη θύρα του." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo conectar a través del servidor proxy. Comprueba su dirección y su puerto." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Yhteyttä ei saatu välityspalvelimen kautta. Tarkista sen osoite ja portti." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de se connecter via le serveur proxy. Vérifiez son adresse et son port." } },
        "hr" : { "stringUnit" : { "state" : "translated", "value" : "Povezivanje putem proxy poslužitelja nije uspjelo. Provjerite njegovu adresu i priključak." } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "Nem sikerült csatlakozni a proxyszerveren keresztül. Ellenőrizze a címét és a portját." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile connettersi tramite il server proxy. Controllane indirizzo e porta." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프록시 서버를 통해 연결할 수 없습니다. 프록시 서버의 주소와 포트를 확인하세요." } },
        "lt" : { "stringUnit" : { "state" : "translated", "value" : "Nepavyko prisijungti per tarpinį serverį. Patikrinkite jo adresą ir prievadą." } },
        "lv" : { "stringUnit" : { "state" : "translated", "value" : "Neizdevās izveidot savienojumu caur proksi serveri. Pārbaudiet tā adresi un portu." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Kunne ikke koble til via proxytjeneren. Kontroller adressen og porten til den." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Kan geen verbinding maken via de proxyserver. Controleer het adres en de poort ervan." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Nie można połączyć się przez serwer proxy. Sprawdź jego adres i port." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível conectar pelo servidor proxy. Verifique o endereço e a porta dele." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível ligar através do servidor proxy. Verifique o endereço e a porta." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Nu s-a putut stabili conexiunea prin serverul proxy. Verificați adresa și portul acestuia." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось подключиться через прокси-сервер. Проверьте его адрес и порт." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Det gick inte att ansluta via proxyservern. Kontrollera dess adress och port." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Proxy sunucusu üzerinden bağlanılamadı. Adresini ve bağlantı noktasını kontrol edin." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося підключитися через проксі-сервер. Перевірте його адресу й порт." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法通过代理服务器连接。请检查其地址和端口。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法透過代理伺服器連線。請檢查其位址和連接埠。" } }
      }
    },
    "Couldn't connect to the server. Check that Transmission is running and that the address and port are right." : {
      "comment" : "Windows only. Shown when the server can't be reached (the Mac shows macOS's own text for these).",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Не ўдалося падключыцца да сервера. Праверце, што Transmission працуе, а адрас і порт правільныя." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "No s’ha pogut connectar al servidor. Comproveu que Transmission s’estigui executant i que l’adreça i el port siguin correctes." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "K serveru se nepodařilo připojit. Zkontrolujte, že Transmission běží a že adresa a port jsou správné." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Kunne ikke oprette forbindelse til serveren. Kontrollér, at Transmission kører, og at adressen og porten er korrekte." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Verbindung zum Server möglich. Prüfe, ob Transmission läuft und ob Adresse und Port stimmen." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Δεν ήταν δυνατή η σύνδεση με τον διακομιστή. Ελέγξτε ότι το Transmission εκτελείται και ότι η διεύθυνση και η θύρα είναι σωστές." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo conectar con el servidor. Comprueba que Transmission esté en ejecución y que la dirección y el puerto sean correctos." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Palvelimeen ei saatu yhteyttä. Tarkista, että Transmission on käynnissä ja että osoite ja portti ovat oikein." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de se connecter au serveur. Vérifiez que Transmission est en cours d’exécution et que l’adresse et le port sont corrects." } },
        "hr" : { "stringUnit" : { "state" : "translated", "value" : "Povezivanje s poslužiteljem nije uspjelo. Provjerite radi li Transmission te jesu li adresa i priključak ispravni." } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "Nem sikerült csatlakozni a szerverhez. Ellenőrizze, hogy a Transmission fut-e, és hogy a cím és a port helyes-e." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile connettersi al server. Controlla che Transmission sia in esecuzione e che indirizzo e porta siano corretti." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "서버에 연결할 수 없습니다. Transmission이 실행 중인지, 주소와 포트가 올바른지 확인하세요." } },
        "lt" : { "stringUnit" : { "state" : "translated", "value" : "Nepavyko prisijungti prie serverio. Patikrinkite, ar „Transmission“ veikia ir ar adresas bei prievadas teisingi." } },
        "lv" : { "stringUnit" : { "state" : "translated", "value" : "Neizdevās izveidot savienojumu ar serveri. Pārbaudiet, vai Transmission darbojas un vai adrese un ports ir pareizi." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Kunne ikke koble til tjeneren. Kontroller at Transmission kjører, og at adressen og porten er riktige." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Kan geen verbinding maken met de server. Controleer of Transmission draait en of het adres en de poort kloppen." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Nie można połączyć się z serwerem. Sprawdź, czy Transmission działa oraz czy adres i port są prawidłowe." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível conectar ao servidor. Verifique se o Transmission está em execução e se o endereço e a porta estão corretos." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível ligar ao servidor. Verifique se o Transmission está em execução e se o endereço e a porta estão corretos." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "Nu s-a putut stabili conexiunea cu serverul. Verificați dacă Transmission rulează și dacă adresa și portul sunt corecte." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось подключиться к серверу. Проверьте, что Transmission запущен, а адрес и порт указаны верно." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Det gick inte att ansluta till servern. Kontrollera att Transmission körs och att adressen och porten stämmer." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sunucuya bağlanılamadı. Transmission’ın çalıştığını ve adres ile bağlantı noktasının doğru olduğunu kontrol edin." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося підключитися до сервера. Перевірте, що Transmission запущено, а адресу й порт указано правильно." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法连接到服务器。请检查 Transmission 是否正在运行，以及地址和端口是否正确。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法連線到伺服器。請檢查 Transmission 是否正在執行，以及位址和連接埠是否正確。" } }
      }
    },
