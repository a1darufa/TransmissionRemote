    "%@ – Transmission Remote (window title)" : {
      "comment" : "Windows only. The window title on the taskbar and in Alt+Tab while a server is set: the server's name, then the app's. The same in every language, as Windows titles are.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ – Transmission Remote" } }
      },
      "shouldTranslate" : false
    },
