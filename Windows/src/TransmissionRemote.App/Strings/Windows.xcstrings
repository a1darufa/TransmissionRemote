    "The server's name couldn't be found. Check the address." : {
      "comment" : "Windows only. Shown when the server can't be reached (the Mac shows macOS's own text for these).",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Не ўдалося знайсці імя сервера. Праверце адрас." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "No s’ha trobat el nom del servidor. Comproveu l’adreça." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Název serveru se nepodařilo najít. Zkontrolujte adresu." } },
