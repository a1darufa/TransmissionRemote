    "The connection to the server failed." : {
      "comment" : "Windows only. Shown when the server can't be reached (the Mac shows macOS's own text for these).",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Не ўдалося злучыцца з серверам." } },
