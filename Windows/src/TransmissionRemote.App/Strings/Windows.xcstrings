    "Something unexpected went wrong. The log files have the details." : {
      "comment" : "Windows only. The connection stopped because of an error the app didn't expect.",
      "localizations" : {
        "be" : { "stringUnit" : { "state" : "translated", "value" : "Здарылася нечаканая памылка. Падрабязнасці ёсць у файлах журнала." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "S’ha produït un error inesperat. Els fitxers de registre en tenen els detalls." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "Došlo k neočekávané chybě. Podrobnosti najdete v souborech protokolu." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Der opstod en uventet fejl. Logfilerne indeholder detaljerne." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Etwas Unerwartetes ist schiefgelaufen. Details stehen in den Protokolldateien." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Παρουσιάστηκε απρόσμενο σφάλμα. Τα αρχεία καταγραφής περιέχουν τις λεπτομέρειες." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se produjo un error inesperado. Los archivos de registro tienen los detalles." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Tapahtui odottamaton virhe. Lokitiedostoissa on lisätietoja." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une erreur inattendue s’est produite. Les fichiers journaux contiennent les détails." } },
        "hr" : { "stringUnit" : { "state" : "translated", "value" : "Došlo je do neočekivane pogreške. Pojedinosti su u datotekama zapisnika." } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "Váratlan hiba történt. A részletek a naplófájlokban találhatók." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Si è verificato un errore imprevisto. I dettagli sono nei file di log." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "예기치 않은 문제가 발생했습니다. 자세한 내용은 로그 파일을 확인하세요." } },
        "lt" : { "stringUnit" : { "state" : "translated", "value" : "Įvyko netikėta klaida. Išsami informacija yra žurnalo failuose." } },
        "lv" : { "stringUnit" : { "state" : "translated", "value" : "Radās neparedzēta kļūda. Sīkāka informācija ir žurnāla failos." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "Det oppstod en uventet feil. Loggfilene har detaljene." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Er is iets onverwachts misgegaan. De logbestanden bevatten de details." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wystąpił nieoczekiwany błąd. Szczegóły znajdziesz w plikach dziennika." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ocorreu um erro inesperado. Os arquivos de registro têm os detalhes." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Ocorreu um erro inesperado. Os ficheiros de registo têm os detalhes." } },
