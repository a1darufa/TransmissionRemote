        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile trovare il nome del server. Controlla l’indirizzo." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "서버 이름을 찾을 수 없습니다. 주소를 확인하세요." } },
        "lt" : { "stringUnit" : { "state" : "translated", "value" : "Nepavyko rasti serverio vardo. Patikrinkite adresą." } },
