<?xml version="1.0" encoding="utf-8"?>
<!-- A centred message in place of content, like the Mac's ContentUnavailableView: a 48 epx icon, a title,
     an optional description and details, and a row of buttons. -->
<UserControl
    x:Class="TransmissionRemote.App.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:TransmissionRemote.App.Presentation">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel
            MaxWidth="480"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <ContentPresenter
                HorizontalAlignment="Center"
                Content="{x:Bind Icon, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                AutomationProperties.HeadingLevel="Level1"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Description, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                Visibility="{x:Bind presentation:Visible.WhenText(Description), Mode=OneWay}" />
            <ContentPresenter HorizontalAlignment="Center" Content="{x:Bind Details, Mode=OneWay}" />
            <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center" Content="{x:Bind Actions, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
