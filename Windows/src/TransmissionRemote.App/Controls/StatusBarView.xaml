<?xml version="1.0" encoding="utf-8"?>
<!-- The strip under the torrent list (brief 4.6; Mac: StatusBarView.swift): connection and count on the left, a
     polling problem next to them, speeds with their limits, free space and the turtle on the right. -->
<UserControl
    x:Class="TransmissionRemote.App.Controls.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:TransmissionRemote.App"
    xmlns:presentation="using:TransmissionRemote.App.Presentation">

    <UserControl.Resources>
        <Style x:Key="StatusText" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="StatusGlyph" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid
        Height="32"
        Padding="12,0,8,0"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="ConnectionInfo" Orientation="Horizontal" Spacing="6">
            <FontIcon x:Name="SecurityGlyph" Style="{StaticResource StatusGlyph}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="TorrentCountText" Style="{StaticResource StatusText}" />
        </StackPanel>

        <!-- Only during a polling problem: the data stays visible, so say how old it is and offer a retry. -->
        <StackPanel
            x:Name="ProblemPanel"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed"
            AutomationProperties.LiveSetting="Polite">
            <FontIcon Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" Style="{StaticResource StatusGlyph}" />
            <TextBlock
                x:Name="ProblemText"
                MaxWidth="360"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{StaticResource StatusText}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="UpdatedText" Style="{StaticResource StatusText}" />
            <Button
                Padding="8,2"
                VerticalAlignment="Center"
                Click="OnTryNow"
                Content="{x:Bind app:Strings.TryNow}"
                FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE74B;" Style="{StaticResource StatusGlyph}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="DownloadText" Style="{StaticResource StatusText}" />
                <TextBlock x:Name="DownloadLimitText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource StatusText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE74A;" Style="{StaticResource StatusGlyph}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="UploadText" Style="{StaticResource StatusText}" />
                <TextBlock x:Name="UploadLimitText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource StatusText}" />
            </StackPanel>
            <StackPanel x:Name="FreeSpacePanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <FontIcon Glyph="&#xEDA2;" Style="{StaticResource StatusGlyph}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="FreeSpaceText" Style="{StaticResource StatusText}" />
            </StackPanel>
            <ToggleButton
                x:Name="TurtleButton"
                Width="32"
                Height="24"
                Padding="0"
                VerticalAlignment="Center"
                Click="OnTurtleClick"
                AutomationProperties.Name="{x:Bind app:Strings.AlternativeSpeedLimits_5A9C91}">
                <PathIcon Data="{x:Bind presentation:FluentIcons.Turtle16()}" />
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>
