<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WinUI 3 app: the interface, the Windows implementations of the view-model library's interfaces,
       and startup. All other logic lives in TransmissionRemote.ViewModels and TransmissionKit.
       Unpackaged and self-contained (the Windows App SDK and .NET ship inside the app folder), built once per
       architecture. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>TransmissionRemote.App</RootNamespace>
    <AssemblyName>TransmissionRemote</AssemblyName>
    <Product>Transmission Remote</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\AppIcon\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- CsWin32 generates the Win32 declarations listed in NativeMethods.txt as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.Main does the single-instance check before any XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Building the solution from the command line asks for "Any CPU"; the app needs a real architecture, so
       it takes this PC's. Pass -p:Platform=x64 or -p:Platform=ARM64 to pick one. -->
  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU' And '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' != 'AnyCPU' And '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- PropertySizer, for the resizable sidebar. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransmissionRemote.ViewModels\TransmissionRemote.ViewModels.csproj" />
    <ProjectReference Include="..\TransmissionKit\TransmissionKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <!-- The taskbar icon; the .exe gets the same file through ApplicationIcon. -->
    <Content Include="..\..\assets\AppIcon\AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The 16 epx title bar icon at each display scale, so MRT picks a sharp frame rather than a scaled one. -->
    <Content Include="..\..\assets\AppIcon\AppIcon-16.png" Link="Assets\TitleBarIcon.scale-100.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\AppIcon\AppIcon-20.png" Link="Assets\TitleBarIcon.scale-125.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\AppIcon\AppIcon-24.png" Link="Assets\TitleBarIcon.scale-150.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\AppIcon\AppIcon-32.png" Link="Assets\TitleBarIcon.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\AppIcon\AppIcon-40.png" Link="Assets\TitleBarIcon.scale-250.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\AppIcon\AppIcon-48.png" Link="Assets\TitleBarIcon.scale-300.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\AppIcon\AppIcon-64.png" Link="Assets\TitleBarIcon.scale-400.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Peers tab's country flags (flag-icons, MIT; see assets/Flags/README.md). -->
    <Content Include="..\..\assets\Flags\*.svg" Link="Assets\Flags\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\Flags\LICENSE" Link="Assets\Flags\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
