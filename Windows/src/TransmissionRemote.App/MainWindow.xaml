<?xml version="1.0" encoding="utf-8"?>
<!-- The main window (brief 3.1): title bar with the menu bar, the command row with the filter box, then the
     sidebar and the content area. The content shows the torrent list while connected and a connection page
     otherwise. Items whose feature comes in a later milestone are disabled: the dialogs (M4), Settings (M5),
     the update check and About (M6). -->
<Window
    x:Class="TransmissionRemote.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:TransmissionRemote.App"
    xmlns:controls="using:TransmissionRemote.App.Controls"
    xmlns:presentation="using:TransmissionRemote.App.Presentation"
    xmlns:shell="using:TransmissionRemote.App.Shell"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:TransmissionRemote.ViewModels"
    xmlns:views="using:TransmissionRemote.App.Views">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="SidebarHeaderTemplate" x:DataType="shell:SidebarHeader">
                <NavigationViewItemHeader Content="{x:Bind Title}" AutomationProperties.HeadingLevel="Level2" />
            </DataTemplate>
            <DataTemplate x:Key="StatusItemTemplate" x:DataType="viewmodels:StatusSidebarItem">
                <NavigationViewItem
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind presentation:SidebarText.AccessibleName(Filter, Count), Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind presentation:SidebarText.Glyph(Filter)}" />
                    </NavigationViewItem.Icon>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind presentation:SidebarText.Label(Filter)}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind presentation:SidebarText.Count(Count), Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </NavigationViewItem>
            </DataTemplate>
            <shell:SidebarTemplateSelector
                x:Key="SidebarTemplates"
                HeaderTemplate="{StaticResource SidebarHeaderTemplate}"
                StatusTemplate="{StaticResource StatusItemTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="{x:Bind app:Strings.TransmissionRemote}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            Subtitle="{x:Bind ViewModel.ServerName, Mode=OneWay}">
            <TitleBar.Resources>
                <!-- The menu bar sits left, next to the title, as in Notepad and Paint; TitleBar centres content. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TitleBarIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <MenuBar x:Name="AppMenuBar">
                    <MenuBarItem Title="{x:Bind app:Strings.File}" AccessKey="{x:Bind app:Strings.FileMenuAccessKey}">
                        <MenuFlyoutItem x:Name="AddTorrentFileItem" IsEnabled="False" Text="{x:Bind app:Strings.AddTorrentFileEllipsis}" />
                        <MenuFlyoutItem x:Name="AddTorrentLinkItem" IsEnabled="False" Text="{x:Bind app:Strings.AddTorrentLinkEllipsis}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SettingsItem" IsEnabled="False" Text="{x:Bind app:Strings.SettingsEllipsis}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="ExitItem" Click="OnExit" Text="{x:Bind app:Strings.Exit}" />
                    </MenuBarItem>

                    <!-- The torrent actions (brief 4.4), filled in code: the same items as the list's context menu. -->
                    <MenuBarItem
                        x:Name="TorrentMenu"
                        Title="{x:Bind app:Strings.Torrent}"
                        AccessKey="{x:Bind app:Strings.TorrentMenuAccessKey}" />

                    <MenuBarItem Title="{x:Bind app:Strings.Server}" AccessKey="{x:Bind app:Strings.ServerMenuAccessKey}">
                        <MenuFlyoutItem x:Name="StartAllItem" Command="{x:Bind ViewModel.StartAllCommand}" Text="{x:Bind app:Strings.StartAll}" />
                        <MenuFlyoutItem x:Name="StopAllItem" Command="{x:Bind ViewModel.StopAllCommand}" Text="{x:Bind app:Strings.StopAll}" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="AlternativeSpeedItem"
                            Command="{x:Bind ViewModel.ToggleAlternativeSpeedCommand}"
                            IsChecked="{x:Bind ViewModel.IsAlternativeSpeedEnabled, Mode=OneWay}"
                            Text="{x:Bind app:Strings.AlternativeSpeedLimits_5A9C91}" />
                        <MenuFlyoutSubItem
                            x:Name="DownloadLimitMenu"
                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                            Text="{x:Bind app:Strings.DownloadSpeedLimit}" />
                        <MenuFlyoutSubItem
                            x:Name="UploadLimitMenu"
                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                            Text="{x:Bind app:Strings.UploadSpeedLimit}" />
                        <MenuFlyoutItem x:Name="ServerSettingsItem" IsEnabled="False" Text="{x:Bind app:Strings.ServerSettingsEllipsis}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="ServerChoiceMenu" Text="{x:Bind app:Strings.Server}" />
                        <MenuFlyoutItem x:Name="ReconnectItem" Command="{x:Bind ViewModel.ReconnectCommand}" Text="{x:Bind app:Strings.Reconnect}" />
                        <MenuFlyoutItem Command="{x:Bind ViewModel.DisconnectCommand}" Text="{x:Bind app:Strings.Disconnect}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem IsEnabled="False" Text="{x:Bind app:Strings.ManageServersEllipsis}" />
                    </MenuBarItem>

                    <MenuBarItem Title="{x:Bind app:Strings.View}" AccessKey="{x:Bind app:Strings.ViewMenuAccessKey}">
                        <ToggleMenuFlyoutItem x:Name="ShowSidebarItem" Click="OnShowSidebarClicked" Text="{x:Bind app:Strings.ShowSidebar}" />
                        <ToggleMenuFlyoutItem
                            x:Name="ShowInfoPaneItem"
                            IsChecked="{x:Bind ViewModel.ShowInfoPane, Mode=TwoWay}"
                            Text="{x:Bind app:Strings.ShowInfoPane}" />
                    </MenuBarItem>

                    <MenuBarItem Title="{x:Bind app:Strings.Help}" AccessKey="{x:Bind app:Strings.HelpMenuAccessKey}">
                        <MenuFlyoutItem IsEnabled="False" Text="{x:Bind app:Strings.CheckForUpdatesEllipsis}" />
                        <MenuFlyoutItem Click="OnOpenLogsFolder" Text="{x:Bind app:Strings.OpenLogsFolder}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem IsEnabled="False" Text="{x:Bind app:Strings.AboutTransmissionRemote}" />
                    </MenuBarItem>
                </MenuBar>
            </TitleBar.Content>
        </TitleBar>

        <!-- The command row (brief 3.3; Mac: MainToolbar.swift): icon-only, names and shortcuts in tooltips. -->
        <Grid Grid.Row="1" Padding="4,0,12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar
                x:Name="Toolbar"
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    x:Name="AddTorrentFileButton"
                    IsEnabled="False"
                    Label="{x:Bind app:Strings.AddTorrentFile}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.AddATorrentFile}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="AddLinkButton"
                    IsEnabled="False"
                    Label="{x:Bind app:Strings.AddLink}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.AddAMagnetLinkOrTorrentURL}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    x:Name="StartButton"
                    Command="{x:Bind ViewModel.StartCommand}"
                    Label="{x:Bind app:Strings.Start}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.StartTheSelectedTorrents}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="StopButton"
                    Command="{x:Bind ViewModel.StopCommand}"
                    Label="{x:Bind app:Strings.Stop}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.StopTheSelectedTorrents}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE769;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="RemoveButton"
                    Click="OnRemoveClicked"
                    IsEnabled="{x:Bind ViewModel.CanActOnSelection, Mode=OneWay}"
                    Label="{x:Bind app:Strings.Remove}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.RemoveTheSelectedTorrents}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarToggleButton
                    x:Name="AlternativeSpeedButton"
                    Command="{x:Bind ViewModel.ToggleAlternativeSpeedCommand}"
                    IsChecked="{x:Bind ViewModel.IsAlternativeSpeedEnabled, Mode=OneWay}"
                    Label="{x:Bind app:Strings.AlternativeSpeedLimits_5A9C91}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.AlternativeSpeedLimits_392B4B}">
                    <AppBarToggleButton.Icon>
                        <PathIcon Data="{x:Bind presentation:FluentIcons.Turtle16()}" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton
                    x:Name="SettingsButton"
                    IsEnabled="False"
                    Label="{x:Bind app:Strings.Settings}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.SettingsForThisAppAndTheConnected}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="ServerButton"
                    Label="{x:Bind app:Strings.Server}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.SwitchServer}">
                    <AppBarButton.Icon>
                        <PathIcon Data="{x:Bind presentation:FluentIcons.Server16()}" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="ServerFlyout" Opening="OnServerFlyoutOpening" Placement="BottomEdgeAlignedLeft" />
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
            <AutoSuggestBox
                x:Name="FilterBox"
                Grid.Column="1"
                Width="280"
                VerticalAlignment="Center"
                PlaceholderText="{x:Bind app:Strings.FilterByName}"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{x:Bind app:Strings.FilterByName}" />
        </Grid>

        <NavigationView
            x:Name="Sidebar"
            Grid.Row="2"
            DisplayModeChanged="OnSidebarDisplayModeChanged"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            MenuItemTemplateSelector="{StaticResource SidebarTemplates}"
            MenuItemsSource="{x:Bind SidebarItems}"
            PaneClosed="OnSidebarPaneChanged"
            PaneDisplayMode="Auto"
            PaneOpened="OnSidebarPaneChanged"
            SelectionChanged="OnSidebarSelectionChanged">
            <Grid>
                <views:ConnectionStateView
                    x:Name="ConnectionPages"
                    Visibility="{x:Bind presentation:Visible.Unless(ViewModel.IsConnected), Mode=OneWay}" />

                <!-- Connected (brief 3.1): errors from actions and adds, the torrent list, the status bar. The list area
                     takes dropped .torrent files and links. -->
                <Grid
                    x:Name="TorrentListHost"
                    AllowDrop="True"
                    DragOver="OnDragOver"
                    Drop="OnDrop"
                    Visibility="{x:Bind presentation:Visible.When(ViewModel.IsConnected), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="ProblemBar"
                        Margin="12,8,12,4"
                        Closed="OnProblemBarClosed"
                        IsOpen="False"
                        Severity="Error"
                        AutomationProperties.LiveSetting="Polite" />
                    <Grid Grid.Row="1">
                        <controls:TorrentTable x:Name="Torrents" />
                        <controls:EmptyStateView
                            Title="{x:Bind app:Strings.NoTorrents}"
                            Margin="0,33,0,0"
                            Description="{x:Bind app:Strings.DropTorrentFilesOrMagnetLinksHereOrUse}"
                            Visibility="{x:Bind presentation:Visible.WhenNone(ViewModel.Rows.Count), Mode=OneWay}">
                            <controls:EmptyStateView.Icon>
                                <FontIcon FontSize="48" Glyph="&#xE896;" />
                            </controls:EmptyStateView.Icon>
                        </controls:EmptyStateView>
                    </Grid>
                    <controls:StatusBarView x:Name="StatusBar" Grid.Row="2" />
                </Grid>

                <!-- Drag the sidebar's edge: between the Mac's 180 and 340 epx. A pointer affordance, as on the Mac: off the
                     tab order, so the focus never lands on it when a focused button disappears. -->
                <toolkit:PropertySizer
                    IsTabStop="False"
                    HorizontalAlignment="Left"
                    Binding="{x:Bind Sidebar.OpenPaneLength, Mode=TwoWay}"
                    Maximum="340"
                    Minimum="180"
                    Visibility="{x:Bind presentation:Visible.When(Sidebar.IsPaneOpen), Mode=OneWay}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
