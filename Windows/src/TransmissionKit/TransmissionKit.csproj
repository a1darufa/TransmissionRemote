<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-free core shared by the Windows app: Transmission's RPC in both protocol generations,
       models, .torrent parsing and helpers. Builds and tests on any OS, so it can be developed on a Mac. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TransmissionKit</RootNamespace>
    <!-- The app may be trimmed or compiled ahead of time; this turns on the analyzers that keep the core safe for it. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the logging abstraction: the app decides where logs go. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TransmissionKit.Tests" />
  </ItemGroup>

</Project>
