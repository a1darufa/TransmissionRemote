<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app's logic without its interface: view models and the services behind them.
       Platform-neutral, so it builds and tests on any OS; the WinUI project binds to it and
       implements the small interfaces in Abstractions/ with Windows APIs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TransmissionRemote.ViewModels</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransmissionKit\TransmissionKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TransmissionRemote.ViewModels.Tests" />
  </ItemGroup>

</Project>
