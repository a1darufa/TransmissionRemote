    "To open downloaded files, choose each local folder once in Settings → Paths, so macOS lets the app open it." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каб адкрываць запампаваныя файлы, адзін раз выберыце кожную лакальную тэчку ў раздзеле «Налады → Шляхі» — тады macOS дазволіць праграме адкрываць яе."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obrir els fitxers descarregats, selecciona un cop cada carpeta local a Configuració → Rutes, perquè macOS permeti que l'app l'obri."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li otevírat stažené soubory, vyberte každou místní složku jednou v Nastavení → Cesty, aby macOS aplikaci dovolil ji otevřít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at åbne downloadede filer skal du vælge hver lokal mappe én gang under Indstillinger → Stier, så macOS giver appen adgang til den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um heruntergeladene Dateien zu öffnen, wähle jeden lokalen Ordner einmal unter Einstellungen → Pfade aus, damit macOS der App den Zugriff erlaubt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να ανοίγετε ληφθέντα αρχεία, επιλέξτε μία φορά κάθε τοπικό φάκελο στις Ρυθμίσεις → Μονοπάτια, ώστε το macOS να επιτρέψει στην εφαρμογή να τον ανοίξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para abrir los archivos descargados, elige cada carpeta local una vez en Ajustes → Rutas, para que macOS permita a la app abrirla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat avata ladattuja tiedostoja, valitse kukin paikallinen kansio kerran kohdassa Asetukset → Sijainnit. Näin macOS sallii apin avata sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ouvrir les fichiers téléchargés, choisissez une fois chaque dossier local dans Réglages → Chemins, afin que macOS autorise l’app à l’ouvrir."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da biste otvarali preuzete datoteke, svaku lokalnu mapu jednom odaberite u Postavkama → Putanje kako bi macOS aplikaciji dopustio da je otvori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letöltött fájlok megnyitásához válassza ki egyszer az egyes helyi mappákat a Beállítások → Elérési utak panelen, hogy a macOS engedélyezze az alkalmazásnak a megnyitásukat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aprire i file scaricati, scegli una volta ogni cartella locale in Impostazioni → Percorsi, così macOS consente all'app di aprirla."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 파일을 열려면 설정 → 경로에서 각 로컬 폴더를 한 번씩 선택하여 macOS가 앱에서 해당 폴더를 열 수 있도록 허용하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad galėtumėte atidaryti parsiųstus failus, kiekvieną vietinį aplanką vieną kartą pasirinkite skiltyje Nustatymai → Keliai – tada macOS leis programai jį atidaryti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai atvērtu lejupielādētos failus, vienreiz izvēlieties katru lokālo mapi sadaļā Iestatījumi → Ceļi, lai macOS ļautu lietotnei to atvērt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å åpne nedlastede filer må du velge hver lokale mappe én gang i Innstillinger → Baner, slik at macOS lar appen åpne den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om gedownloade bestanden te openen, kies je elke lokale map één keer in Instellingen → Paden, zodat macOS de app toegang geeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby otwierać pobrane pliki, wybierz raz każdy folder lokalny w Ustawieniach → Ścieżki – wtedy macOS pozwoli aplikacji go otwierać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para abrir arquivos baixados, escolha cada pasta local uma vez em Ajustes → Caminhos, para que o macOS permita que o app a abra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para abrir ficheiros transferidos, escolha cada pasta local uma vez em Definições → Caminhos, para que o macOS permita que a app a abra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a deschide fișierele descărcate, alegeți o dată fiecare dosar local în Configurări → Căi, ca macOS să permită aplicației să îl deschidă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы открывать загруженные файлы, один раз выберите каждую локальную папку в разделе «Настройки → Пути» — тогда macOS разрешит программе открывать её."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill öppna nedladdade filer väljer du varje lokal mapp en gång i Inställningar → Sökvägar, så att macOS låter appen öppna den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen dosyaları açmak için her yerel klasörü Ayarlar → Yollar bölümünde bir kez seçin; böylece macOS uygulamanın o klasörü açmasına izin verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб відкривати завантажені файли, один раз виберіть кожну локальну папку в розділі «Параметри → Шляхи» — тоді macOS дозволить програмі відкривати її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要打开已下载的文件，请在“设置 → 路径”中为每个本地文件夹选择一次，以便 macOS 允许此 App 打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要打開已下載的檔案，請在「設定 → 路徑」中為每個本機檔案夾選擇一次，讓 macOS 允許此 App 打開它。"
          }
        }
      }
    },
