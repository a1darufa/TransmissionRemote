    "Only folders already used on this server are listed. To use a new one, type its path." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут паказаны толькі тэчкі, якія ўжо выкарыстоўваліся на гэтым серверы. Каб выкарыстаць новую, увядзіце яе шлях."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només es mostren les carpetes ja utilitzades en aquest servidor. Per utilitzar-ne una de nova, escriu-ne la ruta."
