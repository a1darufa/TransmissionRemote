          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedůvěryhodný certifikát. Připojte se z hlavního okna, kde ho můžete zkontrolovat a označit jako důvěryhodný (%@…)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke-betroet certifikat. Opret forbindelse fra hovedvinduet for at gennemse og stole på det (%@…)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht vertrauenswürdiges Zertifikat. Stelle die Verbindung im Hauptfenster her, um es zu prüfen und ihm zu vertrauen (%@…)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη αξιόπιστο πιστοποιητικό. Συνδεθείτε από το κύριο παράθυρο για να το ελέγξετε και να το εμπιστευτείτε (%@…)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificado no fiable. Conéctate desde la ventana principal para revisarlo y confiar en él (%@…)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epäluotettava varmenne. Yhdistä pääikkunasta, niin voit tarkistaa sen ja luottaa siihen (%@…)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificat non approuvé. Connectez-vous depuis la fenêtre principale pour l’examiner et lui faire confiance (%@…)."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepouzdan certifikat. Povežite se iz glavnog prozora kako biste ga pregledali i označili kao pouzdan (%@…)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem megbízható tanúsítvány. Csatlakozzon a főablakból, hogy megtekinthesse és megbízhatónak jelölhesse (%@…)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificato non attendibile. Connettiti dalla finestra principale per esaminarlo e considerarlo attendibile (%@…)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 없는 인증서입니다. 메인 윈도우에서 연결하여 검토한 후 신뢰하십시오(%@…)."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepatikimas sertifikatas. Prisijunkite iš pagrindinio lango, kad jį peržiūrėtumėte ir juo pasitikėtumėte (%@…)."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuzticams sertifikāts. Izveidojiet savienojumu no galvenā loga, lai to pārskatītu un tam uzticētos (%@…)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke-klarert sertifikat. Koble til fra hovedvinduet for å se gjennom og stole på det (%@…)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet-vertrouwd certificaat. Maak verbinding vanuit het hoofdvenster om het te controleren en te vertrouwen (%@…)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niezaufany certyfikat. Połącz się z okna głównego, aby go sprawdzić i mu zaufać (%@…)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificado não confiável. Conecte-se pela janela principal para revisá-lo e confiar nele (%@…)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificado não fidedigno. Ligue-se a partir da janela principal para o rever e confiar nele (%@…)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificat nesigur. Conectați-vă din fereastra principală pentru a-l examina și a-i acorda încredere (%@…)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоверенный сертификат. Подключитесь из главного окна, чтобы проверить его и доверять ему (%@…)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ej betrott certifikat. Anslut från huvudfönstret för att granska och lita på det (%@…)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenilmeyen sertifika. İncelemek ve güvenmek için ana pencereden bağlanın (%@…)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недовірений сертифікат. Підключіться з головного вікна, щоб переглянути його та довіритися йому (%@…)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证书不受信任。请从主窗口连接以检查并信任该证书（%@…）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "憑證不受信任。請從主視窗連線以檢查並信任此憑證（%@…）。"
          }
        }
      }
    },
