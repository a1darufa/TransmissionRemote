    "Couldn't open %@. Check that the share is mounted, and choose its folder again in Settings → Paths." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не ўдалося адкрыць %@. Пераканайцеся, што агульны рэсурс падключаны, і зноў выберыце яго тэчку ў раздзеле «Налады → Шляхі»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut obrir %@. Comprova que el recurs compartit estigui muntat i torna a seleccionar la seva carpeta a Configuració → Rutes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nelze otevřít. Zkontrolujte, zda je sdílená složka připojena, a znovu ji vyberte v Nastavení → Cesty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kunne ikke åbnes. Kontrollér, at delingen er tilsluttet, og vælg dens mappe igen under Indstillinger → Stier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht geöffnet werden. Prüfe, ob die Freigabe eingebunden ist, und wähle ihren Ordner unter Einstellungen → Pfade erneut aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό το άνοιγμα του %@. Βεβαιωθείτε ότι ο κοινόχρηστος φάκελος είναι προσαρτημένος και επιλέξτε ξανά τον φάκελό του στις Ρυθμίσεις → Μονοπάτια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido abrir %@. Comprueba que el recurso compartido está montado y vuelve a elegir su carpeta en Ajustes → Rutas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohdetta %@ ei voitu avata. Tarkista, että jako on liitetty, ja valitse sen kansio uudelleen kohdassa Asetukset → Sijainnit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir %@. Vérifiez que le partage est monté, puis choisissez à nouveau son dossier dans Réglages → Chemins."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće otvoriti %@. Provjerite je li dijeljeni resurs spojen i ponovno odaberite njegovu mapu u Postavkama → Putanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült megnyitni: %@. Ellenőrizze, hogy a megosztás csatolva van-e, és válassza ki újra a mappáját a Beállítások → Elérési utak panelen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire %@. Verifica che la condivisione sia montata e scegli di nuovo la sua cartella in Impostazioni → Percorsi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 열 수 없습니다. 공유가 마운트되어 있는지 확인한 다음, 설정 → 경로에서 해당 폴더를 다시 선택하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko atidaryti %@. Patikrinkite, ar bendrinamas aplankas prijungtas, ir iš naujo pasirinkite jo aplanką skiltyje Nustatymai → Keliai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās atvērt %@. Pārbaudiet, vai koplietojums ir piemontēts, un vēlreiz izvēlieties tā mapi sadaļā Iestatījumi → Ceļi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke åpne %@. Kontroller at delingen er montert, og velg mappen på nytt i Innstillinger → Baner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan %@ niet openen. Controleer of de gedeelde map is gekoppeld en kies de map opnieuw in Instellingen → Paden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można otworzyć %@. Sprawdź, czy udział jest zamontowany, i ponownie wybierz jego folder w Ustawieniach → Ścieżki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir %@. Verifique se o compartilhamento está montado e escolha a pasta novamente em Ajustes → Caminhos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir %@. Verifique se a partilha está montada e escolha novamente a respetiva pasta em Definições → Caminhos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nu a putut fi deschis. Verificați dacă partajarea este montată și alegeți din nou dosarul ei în Configurări → Căi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть %@. Убедитесь, что общий ресурс подключён, и снова выберите его папку в разделе «Настройки → Пути»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte öppna %@. Kontrollera att den delade mappen är monterad och välj mappen igen i Inställningar → Sökvägar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ açılamadı. Paylaşımın bağlı olduğunu denetleyin ve klasörünü Ayarlar → Yollar bölümünde yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося відкрити %@. Переконайтеся, що спільний ресурс підключено, і знову виберіть його папку в розділі «Параметри → Шляхи»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开 %@。请检查共享是否已装载，然后在“设置 → 路径”中重新选择其文件夹。"
