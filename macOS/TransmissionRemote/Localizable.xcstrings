    "Automatic uses JSON-RPC 2.0 on Transmission 4.1 and later, and the legacy protocol on older versions such as 3.00." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У аўтаматычным рэжыме выкарыстоўваецца JSON-RPC 2.0 для Transmission 4.1 і навейшых і састарэлы пратакол для старэйшых версій, напрыклад 3.00."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automàtic utilitza JSON-RPC 2.0 amb Transmission 4.1 i posteriors, i el protocol antic amb versions anteriors com la 3.00."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V automatickém režimu se u Transmission 4.1 a novějších používá JSON-RPC 2.0 a u starších verzí, jako je 3.00, starší protokol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automatisk” bruger JSON-RPC 2.0 på Transmission 4.1 og nyere og den ældre protokol på ældre versioner som 3.00."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ verwendet JSON-RPC 2.0 ab Transmission 4.1 und das alte Protokoll bei älteren Versionen wie 3.00."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αυτόματη επιλογή χρησιμοποιεί JSON-RPC 2.0 στο Transmission 4.1 και νεότερα και το παλαιό πρωτόκολλο σε παλαιότερες εκδόσεις, όπως η 3.00."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático usa JSON-RPC 2.0 en Transmission 4.1 o posterior, y el protocolo heredado en versiones anteriores, como la 3.00."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen käyttää JSON-RPC 2.0:aa Transmissionin versiosta 4.1 alkaen ja vanhaa protokollaa vanhemmissa versioissa, kuten 3.00."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Automatique utilise JSON-RPC 2.0 avec Transmission 4.1 ou ultérieur, et l’ancien protocole avec les versions plus anciennes comme la 3.00."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski način koristi JSON-RPC 2.0 na Transmissionu 4.1 i novijem, a stariji protokol na starijim verzijama poput 3.00."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Automatikus beállítás a Transmission 4.1-es és újabb verzióinál JSON-RPC 2.0-t, a régebbieknél (például 3.00) a régi protokollt használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico usa JSON-RPC 2.0 con Transmission 4.1 e versioni successive, e il protocollo precedente con versioni meno recenti come la 3.00."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘자동’은 Transmission 4.1 이상에서는 JSON-RPC 2.0을, 3.00 등 이전 버전에서는 레거시 프로토콜을 사용합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatinis režimas su Transmission 4.1 ir naujesnėmis versijomis naudoja JSON-RPC 2.0, o su senesnėmis, pvz., 3.00, – senąjį protokolą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automātiskais režīms izmanto JSON-RPC 2.0 ar Transmission 4.1 un jaunākām versijām, bet vecākām versijām, piemēram, 3.00, — veco protokolu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk bruker JSON-RPC 2.0 med Transmission 4.1 og nyere, og den eldre protokollen med eldre versjoner som 3.00."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Automatisch’ gebruikt JSON-RPC 2.0 bij Transmission 4.1 en later, en het oude protocol bij oudere versies zoals 3.00."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb automatyczny używa JSON-RPC 2.0 w Transmission 4.1 i nowszych, a starszego protokołu w starszych wersjach, takich jak 3.00."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático usa JSON-RPC 2.0 no Transmission 4.1 ou posterior, e o protocolo legado em versões mais antigas, como a 3.00."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático usa JSON-RPC 2.0 no Transmission 4.1 ou posterior, e o protocolo legado em versões anteriores, como a 3.00."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automat folosește JSON-RPC 2.0 cu Transmission 4.1 și versiunile ulterioare, iar protocolul vechi cu versiunile mai vechi, precum 3.00."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В автоматическом режиме используется JSON-RPC 2.0 для Transmission 4.1 и новее и устаревший протокол для более старых версий, например 3.00."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiskt använder JSON-RPC 2.0 med Transmission 4.1 och senare, och det äldre protokollet med äldre versioner som 3.00."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik seçeneği Transmission 4.1 ve sonrasında JSON-RPC 2.0’ı, 3.00 gibi eski sürümlerde ise eski protokolü kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В автоматичному режимі використовується JSON-RPC 2.0 для Transmission 4.1 і новіших та застарілий протокол для старіших версій, як-от 3.00."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会在 Transmission 4.1 及更高版本上使用 JSON-RPC 2.0，在 3.00 等旧版本上使用旧版协议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會在 Transmission 4.1 及以上版本使用 JSON-RPC 2.0，在 3.00 等舊版本使用舊版協定。"
          }
        }
      }
    },
