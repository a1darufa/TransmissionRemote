    "Folders appear here once torrents are saved on this server." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэчкі з’явяцца тут, калі на гэтым серверы будуць захаваны торэнты."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les carpetes apareixen aquí quan es desen torrents en aquest servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složky se zde zobrazí, jakmile se na tento server uloží torrenty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapper vises her, når der er gemt torrents på denne server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner erscheinen hier, sobald Torrents auf diesem Server gespeichert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φάκελοι εμφανίζονται εδώ μόλις αποθηκευτούν torrent σε αυτόν τον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
