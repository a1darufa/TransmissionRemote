    "Only for HTTPS reverse proxies that ask for one. Choose a .p12 file with the certificate and its key." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толькі для адваротных проксі HTTPS, якія яго патрабуюць. Выберыце файл .p12 з сертыфікатам і яго ключом."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només per a proxys inversos HTTPS que en demanin un. Selecciona un fitxer .p12 amb el certificat i la seva clau."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen pro reverzní proxy HTTPS, které ho vyžadují. Vyberte soubor .p12 s certifikátem a jeho klíčem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun til HTTPS-reverse proxyer, der beder om et. Vælg en .p12-fil med certifikatet og dets nøgle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für HTTPS-Reverse-Proxys, die eines verlangen. Wähle eine .p12-Datei mit dem Zertifikat und seinem Schlüssel aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο για αντίστροφους διακομιστές proxy HTTPS που το ζητούν. Επιλέξτε ένα αρχείο .p12 με το πιστοποιητικό και το κλειδί του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para proxies inversos HTTPS que lo soliciten. Elige un archivo .p12 con el certificado y su clave."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain HTTPS-käänteisvälityspalvelimille, jotka sitä pyytävät. Valitse .p12-tiedosto, jossa on varmenne ja sen avain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement pour les proxys inverses HTTPS qui en demandent un. Choisissez un fichier .p12 contenant le certificat et sa clé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo za HTTPS obrnute proxy poslužitelje koji ga traže. Odaberite .p12 datoteku s certifikatom i njegovim ključem."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak olyan HTTPS fordított proxykhoz, amelyek ezt kérik. Válasszon egy .p12 fájlt, amely a tanúsítványt és a kulcsát is tartalmazza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per i reverse proxy HTTPS che lo richiedono. Scegli un file .p12 con il certificato e la sua chiave."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라이언트 인증서를 요구하는 HTTPS 리버스 프록시에만 해당합니다. 인증서와 해당 키가 포함된 .p12 파일을 선택하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik HTTPS atvirkštiniams tarpiniams serveriams, kurie jo reikalauja. Pasirinkite .p12 failą su sertifikatu ir jo raktu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
