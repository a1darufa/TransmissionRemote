    "Comma-separated speeds for the Speed Limit menus in the torrent menu and the Server menu. Unlimited is always offered." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хуткасці праз коску для падменю абмежавання хуткасці ў меню торэнта і меню «Сервер». Варыянт «Неабмежавана» ёсць заўсёды."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocitats separades per comes per als menús de límit de velocitat del menú Torrent i del menú Servidor. Sempre s'ofereix «Il·limitat»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlosti oddělené čárkami pro nabídky limitu rychlosti v nabídkách Torrent a Server. Možnost Neomezeně je nabízena vždy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommaseparerede hastigheder til menuerne Hastighedsgrænse i menuen Torrent og menuen Server. Ubegrænset tilbydes altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Kommas getrennte Geschwindigkeiten für die Geschwindigkeitslimit-Menüs im Menü „Torrent“ und im Menü „Server“. „Unbegrenzt“ wird immer angeboten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ταχύτητες χωρισμένες με κόμμα για τα μενού ορίου ταχύτητας στο μενού torrent και στο μενού διακομιστή. Η επιλογή «Χωρίς όριο» προσφέρεται πάντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidades separadas por comas para los menús de límite de velocidad del menú Torrent y del menú Servidor. Ilimitado siempre está disponible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilkuilla erotetut nopeudet Torrentti- ja Palvelin-valikoiden nopeusrajoitusvalikoihin. Rajoittamaton on aina valittavissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesses séparées par des virgules pour les menus de limite de vitesse du menu Torrent et du menu Serveur. « Illimité » est toujours proposé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brzine odvojene zarezima za izbornike ograničenja brzine u izbornicima Torrent i Poslužitelj. Opcija Neograničeno uvijek je ponuđena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vesszővel elválasztott sebességek a Torrent és a Szerver menü sebességkorlát-almenüihez. A Korlátlan mindig elérhető."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità separate da virgole per i menu Limite di velocità nel menu Torrent e nel menu Server. L'opzione Illimitata è sempre disponibile."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토렌트 메뉴와 서버 메뉴의 속도 제한 메뉴에 표시할 속도이며, 쉼표로 구분합니다. ‘제한 없음’은 항상 제공됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kableliais atskirti greičiai, rodomi greičio ribojimo meniu torento ir serverio meniu. „Neribotai“ siūloma visada."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar komatiem atdalīti ātrumi ātruma ierobežojuma izvēlnēm torrenta izvēlnē un servera izvēlnē. Vienmēr tiek piedāvāts arī “Neierobežots”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommadelte hastigheter for hastighetsgrensemenyene i Torrent-menyen og Tjener-menyen. Ubegrenset er alltid med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door komma’s gescheiden snelheden voor de snelheidslimietmenu’s in het menu Torrent en het menu Server. ‘Onbeperkt’ wordt altijd aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prędkości oddzielone przecinkami, wyświetlane w menu limitów prędkości w menu Torrent i Serwer. Opcja Bez limitów jest zawsze dostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidades separadas por vírgulas para os menus de limite de velocidade no menu Torrent e no menu Servidor. Ilimitado está sempre disponível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidades separadas por vírgulas para os menus de limite de velocidade no menu Torrent e no menu Servidor. Ilimitado está sempre disponível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viteze separate prin virgulă pentru submeniurile de limită de viteză din meniurile Torent și Server. Nelimitat este oferit întotdeauna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорости через запятую для подменю ограничения скорости в меню торрента и в меню «Сервер». Вариант «Не ограничено» есть всегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommaavgränsade hastigheter för hastighetsgränsmenyerna i menyn Torrent och menyn Server. Obegränsat finns alltid med."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrent ve Sunucu menülerindeki hız limiti alt menüleri için virgülle ayrılmış hızlar. Limitsiz her zaman sunulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення швидкості через кому для підменю обмеження швидкості в меню торренту та меню «Сервер». Варіант «Необмежено» доступний завжди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Torrent”菜单和“服务器”菜单中速度限制菜单所列的速度，以逗号分隔。始终提供“无限制”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Torrent」選單和「伺服器」選單中速度限制選單所列的速度，以逗號分隔。一律提供「無限制」。"
          }
        }
      }
    },
