          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare for omvendte HTTPS-proxyer som ber om det. Velg en .p12-fil med sertifikatet og nøkkelen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen voor HTTPS-reverseproxy’s die erom vragen. Kies een .p12-bestand met het certificaat en de bijbehorende sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko dla odwrotnych serwerów proxy HTTPS, które go wymagają. Wybierz plik .p12 z certyfikatem i jego kluczem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente para proxies reversos HTTPS que o solicitem. Escolha um arquivo .p12 com o certificado e a chave dele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas para proxies inversos HTTPS que o solicitem. Escolha um ficheiro .p12 com o certificado e a respetiva chave."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar pentru proxy-urile inverse HTTPS care îl solicită. Alegeți un fișier .p12 cu certificatul și cheia sa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только для обратных прокси HTTPS, которые его запрашивают. Выберите файл .p12 с сертификатом и его ключом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast för omvända HTTPS-proxyer som kräver ett. Välj en .p12-fil med certifikatet och dess nyckel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bunu isteyen HTTPS ters proxy’leri için. Sertifikayı ve anahtarını içeren bir .p12 dosyası seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише для зворотних проксі HTTPS, які його вимагають. Виберіть файл .p12 із сертифікатом і його ключем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅适用于要求客户端证书的 HTTPS 反向代理。请选择包含证书及其密钥的 .p12 文件。"
