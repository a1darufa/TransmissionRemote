            "value" : "Las carpetas aparecerán aquí cuando se guarden torrents en este servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansiot näkyvät tässä, kun tälle palvelimelle on tallennettu torrentteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers apparaissent ici une fois que des torrents sont enregistrés sur ce serveur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mape će se ovdje pojaviti kada se torrenti spreme na ovaj poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
