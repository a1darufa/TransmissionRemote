    "This server uses plain HTTP over the internet, so your password would be sent unencrypted. Use HTTPS, a VPN such as Tailscale, or allow the unencrypted connection for this server." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэты сервер выкарыстоўвае звычайны HTTP праз інтэрнэт, таму пароль будзе адпраўлены без шыфравання. Выкарыстоўвайце HTTPS, VPN (напрыклад, Tailscale) або дазвольце незашыфраванае падлучэнне для гэтага сервера."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest servidor utilitza HTTP sense xifrar per Internet, de manera que la contrasenya s'enviaria sense xifrar. Utilitza HTTPS, una VPN com Tailscale, o permet la connexió no xifrada per a aquest servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server používá prosté HTTP přes internet, takže by vaše heslo bylo odesláno nešifrovaně. Použijte HTTPS, VPN, jako je Tailscale, nebo pro tento server povolte nešifrované připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne server bruger almindelig HTTP over internettet, så din adgangskode ville blive sendt ukrypteret. Brug HTTPS, et VPN som Tailscale, eller tillad den ukrypterede forbindelse for denne server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server verwendet einfaches HTTP über das Internet, dein Passwort würde also unverschlüsselt gesendet. Verwende HTTPS, ein VPN wie Tailscale oder erlaube die unverschlüsselte Verbindung für diesen Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής χρησιμοποιεί απλό HTTP μέσω διαδικτύου, οπότε το συνθηματικό σας θα στελνόταν χωρίς κρυπτογράφηση. Χρησιμοποιήστε HTTPS, ένα VPN όπως το Tailscale ή επιτρέψτε τη μη κρυπτογραφημένη σύνδεση για αυτόν τον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor usa HTTP sin cifrar a través de internet, así que tu contraseña se enviaría sin cifrar. Usa HTTPS, una VPN como Tailscale o permite la conexión sin cifrar para este servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelin käyttää pelkkää HTTP:tä internetin yli, joten salasanasi lähetettäisiin salaamattomana. Käytä HTTPS:ää, VPN:ää kuten Tailscalea tai salli salaamaton yhteys tälle palvelimelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur utilise du HTTP simple sur Internet : votre mot de passe serait envoyé sans chiffrement. Utilisez HTTPS, un VPN comme Tailscale, ou autorisez la connexion non chiffrée pour ce serveur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj poslužitelj koristi običan HTTP preko interneta pa bi se vaša lozinka poslala nešifrirano. Upotrijebite HTTPS, VPN kao što je Tailscale ili dopustite nešifriranu vezu za ovaj poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a szerver egyszerű HTTP-t használ az interneten keresztül, így a jelszava titkosítatlanul kerülne elküldésre. Használjon HTTPS-t, VPN-t (például Tailscale-t), vagy engedélyezze a titkosítatlan kapcsolatot ennél a szervernél."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server usa HTTP semplice su Internet, quindi la password verrebbe inviata senza crittografia. Usa HTTPS, una VPN come Tailscale, oppure consenti la connessione non crittografata per questo server."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버는 인터넷을 통해 일반 HTTP를 사용하므로 암호가 암호화되지 않은 상태로 전송됩니다. HTTPS 또는 Tailscale 같은 VPN을 사용하거나 이 서버에 대해 암호화되지 않은 연결을 허용하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis serveris naudoja paprastą HTTP internetu, todėl slaptažodis būtų siunčiamas nešifruotas. Naudokite HTTPS, VPN, pvz., Tailscale, arba leiskite šiam serveriui nešifruotą ryšį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis serveris izmanto vienkāršu HTTP caur internetu, tāpēc parole tiktu nosūtīta nešifrēta. Izmantojiet HTTPS, VPN, piemēram, Tailscale, vai atļaujiet šim serverim nešifrētu savienojumu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tjeneren bruker vanlig HTTP over internett, så passordet ditt ville blitt sendt ukryptert. Bruk HTTPS, et VPN som Tailscale, eller tillat den ukrypterte tilkoblingen for denne tjeneren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server gebruikt gewone HTTP via het internet, dus je wachtwoord zou onversleuteld worden verstuurd. Gebruik HTTPS, een VPN zoals Tailscale, of sta de onversleutelde verbinding toe voor deze server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer używa zwykłego HTTP przez internet, więc hasło zostałoby wysłane bez szyfrowania. Użyj HTTPS, sieci VPN, takiej jak Tailscale, lub zezwól na nieszyfrowane połączenie dla tego serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor usa HTTP sem criptografia pela internet, então sua senha seria enviada sem criptografia. Use HTTPS, uma VPN como o Tailscale ou permita a conexão não criptografada para este servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor usa HTTP sem encriptação através da internet, pelo que a sua palavra-passe seria enviada sem encriptação. Use HTTPS, uma VPN como o Tailscale ou permita a ligação não encriptada para este servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest server folosește HTTP simplu prin internet, așa că parola ar fi trimisă necriptat. Folosiți HTTPS, un VPN precum Tailscale sau permiteți conexiunea necriptată pentru acest server."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер использует обычный HTTP через интернет, поэтому пароль будет передан без шифрования. Используйте HTTPS, VPN (например, Tailscale) или разрешите незашифрованное подключение для этого сервера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här servern använder vanlig HTTP över internet, så ditt lösenord skulle skickas okrypterat. Använd HTTPS, ett VPN som Tailscale eller tillåt den okrypterade anslutningen för den här servern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucu internet üzerinden düz HTTP kullanıyor, bu yüzden parolanız şifrelenmeden gönderilir. HTTPS ya da Tailscale gibi bir VPN kullanın veya bu sunucu için şifrelenmemiş bağlantıya izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей сервер використовує звичайний HTTP через інтернет, тому пароль буде надіслано без шифрування. Використовуйте HTTPS, VPN (наприклад, Tailscale) або дозвольте незашифроване підключення для цього сервера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器通过互联网使用普通 HTTP，你的密码将以未加密方式发送。请使用 HTTPS、Tailscale 等 VPN，或允许此服务器使用未加密连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此伺服器透過網際網路使用一般 HTTP，你的密碼會以未加密方式傳送。請使用 HTTPS、Tailscale 等 VPN，或允許此伺服器使用未加密連線。"
          }
        }
      }
    },
    "This server's client certificate is missing from the Keychain. Choose it again in Settings → Transmission." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертыфіката кліента для гэтага сервера няма ў звязцы ключоў. Выберыце яго зноў у раздзеле «Налады → Transmission»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificat de client d'aquest servidor no és al clauer. Torna a seleccionar-lo a Configuració → Transmission."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klientský certifikát tohoto serveru chybí v Klíčence. Vyberte ho znovu v Nastavení → Transmission."
