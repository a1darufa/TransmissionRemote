    "Asks GitHub for the newest release. Nothing is downloaded or installed automatically." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правярае наяўнасць новага выпуску на GitHub. Нічога не запампоўваецца і не ўсталёўваецца аўтаматычна."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta GitHub per obtenir la versió més recent. No es descarrega ni s'instal·la res automàticament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjistí na GitHubu nejnovější vydání. Nic se automaticky nestahuje ani neinstaluje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørger GitHub om den nyeste version. Intet downloades eller installeres automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
