    "Save the URL first if you changed it; the server downloads the list itself." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі вы змянілі URL, спачатку захавайце яго: сервер запампоўвае спіс сам."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si has canviat l'URL, desa'l primer; el servidor descarrega la llista ell mateix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jste URL změnili, nejprve ji uložte – server si seznam stahuje sám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem URL’en først, hvis du har ændret den. Serveren downloader selv listen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere zuerst die URL, falls du sie geändert hast. Der Server lädt die Liste selbst herunter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε πρώτα το URL αν το αλλάξατε· ο διακομιστής κατεβάζει μόνος του τη λίστα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si has cambiado la URL, guárdala primero; el servidor descarga la lista por sí mismo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna URL-osoite ensin, jos muutit sitä; palvelin lataa luettelon itse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez d’abord l’URL si vous l’avez modifiée ; le serveur télécharge lui-même la liste."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako ste promijenili URL, najprije ga spremite – poslužitelj sam preuzima popis."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha módosította az URL-t, előbb mentse el; a listát maga a szerver tölti le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai modificato l'URL, salvalo prima; il server scarica la lista autonomamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL을 변경했다면 먼저 저장하십시오. 목록은 서버가 직접 다운로드합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei pakeitėte URL, pirmiausia jį išsaugokite – serveris sąrašą parsiunčia pats."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja mainījāt URL, vispirms to saglabājiet; serveris sarakstu lejupielādē pats."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre URL-en først hvis du har endret den; tjeneren laster ned listen selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar eerst de URL als je die hebt gewijzigd; de server downloadt de lijst zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zmieniono adres URL, najpierw go zapisz – serwer sam pobiera listę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
