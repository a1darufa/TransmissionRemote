    "Bandwidth groups need Transmission 4.0 or later." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для груп хуткасці патрэбны Transmission 4.0 або навейшы."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els grups d'ample de banda requereixen Transmission 4.0 o posterior."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupiny šířky pásma vyžadují Transmission 4.0 nebo novější."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båndbreddegrupper kræver Transmission 4.0 eller nyere."
          }
