        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅適用於要求用戶端憑證的 HTTPS 反向代理伺服器。請選擇包含憑證及其金鑰的 .p12 檔案。"
          }
        }
      }
    },
    "Only trust it if it matches the certificate you installed on your server." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давярайце яму, толькі калі ён супадае з сертыфікатам, усталяваным на вашым серверы."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confia-hi només si coincideix amb el certificat que vas instal·lar al servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Důvěřujte mu, jen pokud odpovídá certifikátu, který jste nainstalovali na server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stol kun på det, hvis det svarer til det certifikat, du har installeret på din server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraue ihm nur, wenn es mit dem Zertifikat übereinstimmt, das du auf deinem Server installiert hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να το εμπιστευτείτε μόνο αν ταιριάζει με το πιστοποιητικό που εγκαταστήσατε στον διακομιστή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confía en él solo si coincide con el certificado que instalaste en tu servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luota siihen vain, jos se vastaa palvelimellesi asentamaasi varmennetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne lui faites confiance que s’il correspond au certificat installé sur votre serveur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vjerujte mu samo ako odgovara certifikatu koji ste instalirali na poslužitelj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak akkor bízzon meg benne, ha egyezik a szerverére telepített tanúsítvánnyal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consideralo attendibile solo se corrisponde al certificato installato sul tuo server."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 설치한 인증서와 일치하는 경우에만 신뢰하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasitikėkite juo tik tada, jei jis sutampa su sertifikatu, kurį įdiegėte savo serveryje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzticieties tam tikai tad, ja tas atbilst sertifikātam, ko instalējāt savā serverī."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stol bare på det hvis det samsvarer med sertifikatet du installerte på tjeneren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrouw het alleen als het overeenkomt met het certificaat dat je op je server hebt geïnstalleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaufaj mu tylko wtedy, gdy zgadza się z certyfikatem zainstalowanym na serwerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só confie nele se corresponder ao certificado que você instalou no seu servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie nele apenas se corresponder ao certificado que instalou no seu servidor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aveți încredere în el doar dacă se potrivește cu certificatul instalat pe serverul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверяйте ему, только если он совпадает с сертификатом, установленным на вашем сервере."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lita bara på det om det stämmer med certifikatet du installerade på servern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca sunucunuza yüklediğiniz sertifikayla eşleşiyorsa güvenin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Довіряйте йому, лише якщо він збігається із сертифікатом, установленим на вашому сервері."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当它与你在服务器上安装的证书一致时才信任它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在它與你在伺服器上安裝的憑證相符時才信任它。"
          }
        }
      }
    },
    "Only with a reverse proxy in front of the daemon. Transmission itself serves plain HTTP." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
